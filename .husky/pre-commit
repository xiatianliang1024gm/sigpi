#!/bin/sh

# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

# Auto-fix safe issues (formatting, lint, import sorting — organizeImports is
# an assist action that only runs under `biome check`, not `format`/`lint`).
# Any remaining non-fixable issue fails the commit.
echo "Auto-fixing formatting, linting, and import sorting..."
pnpm exec biome check --write .
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

# Restage files that were previously staged and may have been modified by fixes
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

# Run the test suite on the fixed tree.
echo "Running tests..."
pnpm run test
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Please fix the errors before committing."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
